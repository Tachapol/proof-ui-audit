# ==============================================================================
# ProofUI Audit Tool — Environment Configuration Example
# ==============================================================================
#
# NOTE: The application is fully functional offline without an API key.
# When GEMINI_API_KEY is not set or left empty, the audit tool automatically
# uses deterministic fallback explanations and recommendations for all rules.
#
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL.
# Copy this file to `.env.local` to configure local keys securely.

# Google Gemini API Key (Optional)
# Used for grounded AI explanation of audited UX/accessibility findings.
# Bound to conservative model temperature (0.1) and strict grounding validation.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Phase 5 Architectural Guarantees:
# 1. AI Data Boundary: Only minimal, projected issue evidence (ruleId, WCAG criterion,
#    status, selector, measured/expected values, exception reason) is transmitted.
#    Screenshots, DOM trees, cookies, auth tokens, file paths, and designer decision
#    history are strictly excluded.
# 2. Provider Selection: Gemini is chosen only when GEMINI_API_KEY is defined and valid.
#    Otherwise, DeterministicExplanationProvider is used without network calls.
# 3. Fallback Behavior: On timeouts (>8000ms), network errors, schema mismatches,
#    or grounding check failures, the system seamlessly falls back to deterministic
#    explanations. The overall audit run never fails due to AI errors.
# 4. Prompt Injection Defense: Audited page content (accessible names, selectors, etc.)
#    is treated as untrusted data within delimited blocks with explicit negative constraints.
# 5. Grounding Checks: AI responses asserting complete compliance, source modification,
#    or invented metrics not in the evidence are strictly rejected.
# ------------------------------------------------------------------------------

# Optional CPE KMUTT server-side provider
CPE_API_BASE_URL=https://gateway.ai.cpe.kmutt.ac.th/v1
CPE_API_KEY=
CPE_MODEL=qwen3.8-27b
